		IL_007e: newobj instance void [Newtonsoft.Json]Newtonsoft.Json.JsonSerializerSettings::.ctor() /* 0A0002B2 */
		IL_0083: dup
		IL_0084: ldc.i4.2
		IL_0085: callvirt instance void [Newtonsoft.Json]Newtonsoft.Json.JsonSerializerSettings::set_StringEscapeHandling(valuetype [Newtonsoft.Json]Newtonsoft.Json.StringEscapeHandling) /* 0A0002B3 */
		IL_008a: call string [Newtonsoft.Json]Newtonsoft.Json.JsonConvert::SerializeObject(object, class [Newtonsoft.Json]Newtonsoft.Json.JsonSerializerSettings) /* 0A0002B4 */
		IL_008f: stloc.1
		IL_0090: ldstr "<!DOCTYPE html>\r\n<html lang=\"pt-BR\">\r\n<head>\r\n<meta charset=\"utf-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n<meta name=\"theme-color\" content=\"#14477d\">\r\n<title>Cotação de compra</title>\r\n<style>\r\n  * { box-sizing: border-box; }\r\n  body { font-family: 'Segoe UI', Arial, sans-serif; margin: 0; background: #f2f4f7; color: #222; -webkit-text-size-adjust: 100%; }\r\n  .topo { background: #14477d; color: #fff; padding: 14px 16px; }\r\n  .topo h1 { margin: 0; font-size: 18px; line-height: 1.3; }\r\n  .topo p { margin: 6px 0 0 0; font-size: 13px; opacity: .92; line-height: 1.5; }\r\n  .topo .prazo { display: inline-block; background: rgba(255,255,255,.16); border-radius: 12px; padding: 1px 9px; margin-top: 2px; }\r\n  .conteudo { max-width: 1140px; margin: 14px auto; padding: 0 12px; }\r\n  .cartao { background: #fff; border: 1px solid #dde3ea; border-radius: 6px; padding: 14px; margin-bottom: 14px; }\r\n\r\n  table { border-collapse: collapse; width: 100%; font-size: 13px; }\r\n  th, td { border: 1px solid #dde3ea; padding: 7px 8px; text-align: left; vertical-align: middle; }\r\n  th { background: #eef2f7; font-weight: 600; position: sticky; top: 0; z-index: 1; }\r\n  tbody tr:nth-child(even) td { background: #fbfcfd; }\r\n  td input[type=text] { width: 100%; border: 1px solid #c6ced8; border-radius: 3px; padding: 6px; font-size: 13px; font-family: inherit; }\r\n  td input[type=text]:focus { outline: 0; border-color: #14477d; box-shadow: 0 0 0 2px rgba(20,71,125,.15); }\r\n  td input.invalido { border-color: #d33; background: #fff3f3; }\r\n  .num { text-align: right; }\r\n  .num input[type=text] { text-align: right; }\r\n  .centro { text-align: center; }\r\n  .centro input[type=checkbox] { width: 20px; height: 20px; cursor: pointer; margin: 0; }\r\n  .titulo { font-weight: 600; }\r\n  .sub { display: block; font-size: 11px; font-weight: 400; color: #6b7683; margin-top: 2px; }\r\n  .sub.alerta { color: #b35c00; font-weight: 600; }\r\n  .grade { display: block; font-size: 11px; font-weight: 400; color: #14477d; margin-top: 3px; line-height: 1.5; }\r\n\r\n  .rodape-campos { display: flex; flex-wrap: wrap; gap: 14px; }\r\n  .campo { display: flex; flex-direction: column; font-size: 13px; flex: 1 1 190px; }\r\n  .campo label { font-weight: 600; margin-bottom: 4px; }\r\n  .campo input, .campo select, .campo textarea { border: 1px solid #c6ced8; border-radius: 3px; padding: 7px; font-size: 13px; font-family: inherit; width: 100%; }\r\n  .campo textarea { resize: vertical; }\r\n\r\n  .acoes { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }\r\n  button { background: #14477d; color: #fff; border: 0; border-radius: 4px; padding: 11px 18px; font-size: 14px; font-family: inherit; cursor: pointer; }\r\n  button:active { opacity: .85; }\r\n  button.secundario { background: #5a6b7d; }\r\n  .aviso { font-size: 13px; color: #555; margin: 0; line-height: 1.55; }\r\n  #mensagem { font-size: 13px; font-weight: 600; }\r\n  #mensagem.ok { color: #1a7a2e; }\r\n  #mensagem.erro { color: #c22; }\r\n  tr.indisponivel td { background: #f7f8f9; color: #9aa4ae; }\r\n  tr.indisponivel .titulo { text-decoration: line-through; }\r\n\r\n  .ajuda { display: inline-flex; align-items: center; justify-content: center; width: 15px; height: 15px;\r\n           border-radius: 50%; background: #8b98a7; color: #fff; font-size: 10px; font-weight: 700;\r\n           cursor: help; position: relative; margin-left: 4px; vertical-align: middle; }\r\n  .ajuda:focus { outline: 2px solid #14477d; outline-offset: 1px; }\r\n  .ajuda::after { content: attr(data-dica); position: absolute; left: 50%; top: calc(100% + 7px);\r\n                  transform: translateX(-50%); width: 230px; background: #2b3947; color: #fff;\r\n                  font-size: 12px; font-weight: 400; line-height: 1.45; text-align: left; padding: 8px 10px;\r\n                  border-radius: 5px; box-shadow: 0 3px 10px rgba(0,0,0,.22); z-index: 5; display: none; }\r\n  .ajuda:hover::after, .ajuda:focus::after, .ajuda.aberta::after { display: block; }\r\n  .ajuda-celula { display: none; }\r\n\r\n  @media (max-width: 860px) {\r\n    .conteudo { margin: 10px auto; padding: 0 8px; }\r\n    .cartao { padding: 10px; }\r\n    table, tbody, tr, td { display: block; width: 100%; }\r\n    thead { display: none; }\r\n    tr { border: 1px solid #dde3ea; border-radius: 6px; margin-bottom: 12px; overflow: hidden; }\r\n    tbody tr:nth-child(even) td { background: transparent; }\r\n    td { border: 0; border-bottom: 1px solid #f0f3f6; display: flex; justify-content: space-between;\r\n         align-items: center; gap: 12px; padding: 9px 10px; text-align: left; min-height: 42px; }\r\n    td:last-child { border-bottom: 0; }\r\n    td::before { content: attr(data-rotulo); font-weight: 600; color: #55606d; flex: 0 0 44%; font-size: 12px; }\r\n    td.titulo { display: block; background: #eef2f7; border-bottom: 1px solid #dde3ea; font-size: 14px; }\r\n    td.titulo::before { content: none; }\r\n    td.num, td.centro { text-align: left; }\r\n    .ajuda-celula { display: inline-flex; }\r\n    .ajuda::after { width: 200px; left: auto; right: 0; transform: none; }\r\n    td input[type=text] { width: 52%; padding: 8px; font-size: 15px; }\r\n    .num input[type=text] { text-align: right; }\r\n    .acoes { flex-direction: column; align-items: stretch; }\r\n    .acoes button { width: 100%; padding: 13px 18px; font-size: 15px; }\r\n    .acoes #mensagem { text-align: center; }\r\n    .campo { flex: 1 1 100%; }\r\n    .campo input, .campo select, .campo textarea { padding: 9px; font-size: 15px; }\r\n  }\r\n</style>\r\n</head>\r\n<body>\r\n<div class=\"topo\">\r\n  <h1 id=\"cabTitulo\"></h1>\r\n  <p id=\"cabSub\"></p>\r\n</div>\r\n<div class=\"conteudo\">\r\n  <div class=\"cartao\">\r\n    <p class=\"aviso\">Preencha o <b>preço unitário</b> dos itens que a sua empresa fornece e desmarque <b>Forneço</b>\r\n    naqueles com os quais não trabalha. Ao final, use <b>Gerar arquivo de resposta</b> e devolva o arquivo,\r\n    ou <b>Copiar resposta</b> e cole o conteúdo na mesma conversa em que recebeu este formulário.</p>\r\n  </div>\r\n  <div class=\"cartao\">\r\n    <table>\r\n      <colgroup>\r\n        <col style=\"width:21%\"><col style=\"width:8%\"><col style=\"width:5%\"><col style=\"width:7%\">\r\n        <col style=\"width:6%\"><col style=\"width:11%\"><col style=\"width:8%\"><col style=\"width:8%\">\r\n        <col style=\"width:13%\"><col style=\"width:7%\"><col style=\"width:6%\">\r\n      </colgroup>\r\n      <thead>\r\n        <tr>\r\n          <th>Item</th><th>Marca</th><th>Un.</th><th class=\"num\">Qtde</th>\r\n          <th class=\"centro\">Forneço <span class=\"ajuda\" tabindex=\"0\" data-dica=\"Deixe marcado se a sua empresa fornece este item. Desmarque para deixá-lo fora da sua proposta.\">?</span></th><th class=\"num\">Preço unitário (R$) <span class=\"ajuda\" tabindex=\"0\" data-dica=\"Informe o preço para o prazo de pagamento que você está oferecendo no fim do formulário. Se você cobra a mais para vender a prazo, o acréscimo já deve estar neste preço.\">?</span></th><th>Marca ofertada</th>\r\n          <th class=\"num\">Qtde mínima <span class=\"ajuda\" tabindex=\"0\" data-dica=\"Menor quantidade que você aceita vender deste item. Se for maior que a quantidade pedida, o item não entra na sua proposta.\">?</span></th><th class=\"num\">Múltiplo <span class=\"ajuda\" tabindex=\"0\" data-dica=\"Preencha SOMENTE se você não fraciona a venda. O valor vai na MESMA unidade do item: se o item está em CX, o múltiplo é em caixas, não no conteúdo da caixa. Em dúvida, deixe em branco.\">?</span></th><th class=\"num\">Entrega (dias) <span class=\"ajuda\" tabindex=\"0\" data-dica=\"Prazo deste item em particular, quando for diferente do prazo geral informado no fim do formulário. Deixe em branco para valer o prazo geral.\">?</span></th><th>Obs.</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody id=\"linhas\"></tbody>\r\n    </table>\r\n  </div>\r\n  <div class=\"cartao\">\r\n    <div class=\"rodape-campos\">\r\n      <div class=\"campo\"><label>Prazo de entrega (dias) <span class=\"ajuda\" tabindex=\"0\" data-dica=\"Prazo que vale para todos os itens da proposta. Se algum item precisar de um prazo diferente, informe na coluna Entrega (dias) da lista — lá o prazo vale só para aquele item.\">?</span></label><input type=\"text\" id=\"prazoEntrega\" value=\"0\" inputmode=\"numeric\"></div>\r\n      <div class=\"campo\"><label>Prazo de pagamento (dias) <span class=\"ajuda\" tabindex=\"0\" data-dica=\"Em quantos dias você espera receber. O preço unitário dos itens deve ser o preço para este prazo — se você cobra a mais para vender a prazo, inclua o acréscimo no preço.\">?</span></label><input type=\"text\" id=\"prazoPagamento\" value=\"0\" inputmode=\"numeric\"></div>\r\n      <div class=\"campo\"><label>Valor do frete (R$)</label><input type=\"text\" id=\"valorFrete\" value=\"0\" inputmode=\"decimal\"></div>\r\n      <div class=\"campo\"><label>Outros custos (R$) <span class=\"ajuda\" tabindex=\"0\" data-dica=\"Custos que você vai cobrar além da mercadoria e do frete: seguro, embalagem, taxas. Informe o total da proposta — o sistema rateia entre os itens.\">?</span></label><input type=\"text\" id=\"valorOutrosCustos\" value=\"0\" inputmode=\"decimal\"></div>\r\n      <div class=\"campo\"><label>Frete</label>\r\n        <select id=\"tipoFrete\">\r\n          <option value=\"0\">Incluso no preço</option>\r\n          <option value=\"1\">Por conta do comprador</option>\r\n          <option value=\"2\">Por conta do fornecedor</option>\r\n        </select>\r\n      </div>\r\n      <div class=\"campo\" style=\"flex:1 1 100%\"><label>Observações</label><textarea id=\"observacao\" rows=\"2\"></textarea></div>\r\n    </div>\r\n  </div>\r\n  <div class=\"cartao acoes\">\r\n    <button onclick=\"baixarResposta()\">Gerar arquivo de resposta</button>\r\n    <button class=\"secundario\" onclick=\"copiarResposta()\">Copiar resposta</button>\r\n    <span id=\"mensagem\"></span>\r\n  </div>\r\n</div>\r\n<script>\r\nvar DADOS = __DADOS__;\r\n\r\nvar ICONE_FORNECO = '<span class=\"ajuda ajuda-celula\" tabindex=\"0\" data-dica=\"Deixe marcado se a sua empresa fornece este item. Desmarque para deixá-lo fora da sua proposta.\">?</span>';\r\nvar ICONE_MINIMA = '<span class=\"ajuda ajuda-celula\" tabindex=\"0\" data-dica=\"Menor quantidade que você aceita vender deste item. Se for maior que a quantidade pedida, o item não entra na sua proposta.\">?</span>';\r\nvar ICONE_MULTIPLO = '<span class=\"ajuda ajuda-celula\" tabindex=\"0\" data-dica=\"Preencha SOMENTE se você não fraciona a venda. O valor vai na MESMA unidade do item: se o item está em CX, o múltiplo é em caixas, não no conteúdo da caixa. Em dúvida, deixe em branco.\">?</span>';\r\nvar ICONE_ENTREGA = '<span class=\"ajuda ajuda-celula\" tabindex=\"0\" data-dica=\"Prazo deste item em particular, quando for diferente do prazo geral informado no fim do formulário. Deixe em branco para valer o prazo geral.\">?</span>';\r\nvar ICONE_PRECO = '<span class=\"ajuda ajuda-celula\" tabindex=\"0\" data-dica=\"Informe o preço para o prazo de pagamento que você está oferecendo no fim do formulário. Se você cobra a mais para vender a prazo, o acréscimo já deve estar neste preço.\">?</span>';\r\n\r\nfunction formatarQtde(v) { return Number(v).toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2}); }\r\n\r\nfunction montarTela() {\r\n  document.title = 'Cotação de compra ' + DADOS.numero + ' - ' + DADOS.emitente;\r\n  document.getElementById('cabTitulo').textContent = 'Cotação de compra nº ' + DADOS.numero + ' - ' + DADOS.emitente;\r\n  document.getElementById('cabSub').innerHTML = escapeHtml(DADOS.descricao) + '<br>Fornecedor: ' + escapeHtml(DADOS.fornecedor) +\r\n    ' <span class=\"prazo\">Responder até ' + escapeHtml(DADOS.prazoResposta) + '</span>';\r\n  var corpo = document.getElementById('linhas');\r\n  for (var i = 0; i < DADOS.itens.length; i++) {\r\n    var item = DADOS.itens[i];\r\n    var tr = document.createElement('tr');\r\n    tr.id = 'linha_' + i;\r\n    var codigo = item.codigoBarras || item.codigoInterno || '';\r\n    var codigoFornecedor = item.codigoFornecedor || '';\r\n    tr.innerHTML =\r\n      '<td class=\"titulo\" data-rotulo=\"Item\">' + escapeHtml(item.descricao) +\r\n        (codigo ? '<span class=\"sub\">' + escapeHtml(codigo) + '</span>' : '') +\r\n        (codigoFornecedor ? '<span class=\"sub\">Seu c&#243;digo: ' + escapeHtml(codigoFornecedor) + '</span>' : '') +\r\n        montarGrade(item) + '</td>' +\r\n      '<td data-rotulo=\"Marca\">' + (escapeHtml(item.marca) || '&mdash;') + '</td>' +\r\n      '<td data-rotulo=\"Unidade\">' + (escapeHtml(item.unidade) || '&mdash;') + '</td>' +\r\n      '<td class=\"num\" data-rotulo=\"Quantidade\">' + formatarQtde(item.quantidade) + '</td>' +\r\n      '<td class=\"centro\" data-rotulo=\"Forneço\"><input type=\"checkbox\" id=\"disp_' + i + '\" checked onchange=\"alternarLinha(' + i + ')\">' + ICONE_FORNECO + '</td>' +\r\n      '<td class=\"num\" data-rotulo=\"Preço unitário (R$)\"><input type=\"text\" id=\"preco_' + i + '\" inputmode=\"decimal\" onblur=\"validarPreco(' + i + ')\">' + ICONE_PRECO + '</td>' +\r\n      '<td data-rotulo=\"Marca ofertada\"><input type=\"text\" id=\"marca_' + i + '\"></td>' +\r\n      '<td class=\"num\" data-rotulo=\"Qtde mínima\"><input type=\"text\" id=\"qmin_' + i + '\" inputmode=\"decimal\">' + ICONE_MINIMA + '</td>' +\r\n      '<td class=\"num\" data-rotulo=\"Múltiplo\"><input type=\"text\" id=\"mult_' + i + '\" inputmode=\"decimal\" oninput=\"avisarMultiplo(' + i + ')\">' + ICONE_MULTIPLO + '<span class=\"sub\" id=\"avisoMult_' + i + '\"></span></td>' +\r\n      '<td class=\"num\" data-rotulo=\"Entrega (dias)\"><input type=\"text\" id=\"prazo_' + i + '\" inputmode=\"numeric\">' + ICONE_ENTREGA + '</td>' +\r\n      '<td data-rotulo=\"Obs.\"><input type=\"text\" id=\"obs_' + i + '\"></td>';\r\n    corpo.appendChild(tr);\r\n  }\r\n}\r\n\r\nfunction montarGrade(item) {\r\n  if (!item.grades || !item.grades.length) return '';\r\n  var partes = [];\r\n  for (var i = 0; i < item.grades.length; i++) {\r\n    var g = item.grades[i];\r\n    if (g.quantidade <= 0) continue;\r\n    partes.push(escapeHtml((g.linha + ' ' + g.coluna).trim()) + ': ' + formatarQtde(g.quantidade));\r\n  }\r\n  if (!partes.length) return '';\r\n  return '<span class=\"grade\">Grade &mdash; ' + partes.join(' &middot; ') + '</span>';\r\n}\r\n\r\nfunction escapeHtml(s) {\r\n  return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\r\n}\r\n\r\nfunction alternarLinha(i) {\r\n  var ativo = document.getElementById('disp_' + i).checked;\r\n  document.getElementById('linha_' + i).className = ativo ? '' : 'indisponivel';\r\n  var campos = ['preco_', 'marca_', 'qmin_', 'mult_', 'prazo_', 'obs_'];\r\n  for (var c = 0; c < campos.length; c++) document.getElementById(campos[c] + i).disabled = !ativo;\r\n}\r\n\r\nfunction parseNumero(texto) {\r\n  var s = String(texto == null ? '' : texto).trim();\r\n  if (s === '') return 0;\r\n  if (s.indexOf(',') >= 0) s = s.split('.').join('').split(',').join('.');\r\n  var n = parseFloat(s);\r\n  return isNaN(n) ? NaN : n;\r\n}\r\n\r\nfunction parseInteiro(texto) {\r\n  var n = parseInt(String(texto == null ? '' : texto).trim(), 10);\r\n  return isNaN(n) ? 0 : n;\r\n}\r\n\r\nfunction avisarMultiplo(i) {\r\n  var aviso = document.getElementById('avisoMult_' + i);\r\n  var multiplo = parseNumero(document.getElementById('mult_' + i).value);\r\n  var pedida = Number(DADOS.itens[i].quantidade);\r\n  var unidade = DADOS.itens[i].unidade || '';\r\n  aviso.className = 'sub';\r\n  aviso.textContent = '';\r\n  if (isNaN(multiplo) || multiplo <= 0 || pedida <= 0) return;\r\n  var ajustada = Math.ceil(pedida / multiplo) * multi